        "Namespace": {
          "Fn::Sub": "Rosewood/Synthetic/${AWS::StackName}"
        },
        "MetricName": "TransactionalEmailDeliveryFailures",
        "Statistic": "Sum",
        "Period": 300,
        "EvaluationPeriods": 1,
        "Threshold": 1,
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "TreatMissingData": "notBreaching"
      }
    },
