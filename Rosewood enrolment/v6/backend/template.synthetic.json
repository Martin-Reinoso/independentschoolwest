        "SourceArn": {
          "Ref": "RosewoodSesEventsTopic"
        }
      }
    },
    "RosewoodErrorsAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmDescription": "Rosewood V6 Lambda errors",
        "Namespace": "AWS/Lambda",
        "MetricName": "Errors",
        "Dimensions": [
