      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmDescription": "A Rosewood email, Slack notification or Google Sheets projection exhausted all delivery attempts",
        "Namespace": {
          "Fn::Sub": "Rosewood/Synthetic/${AWS::StackName}"
        },
        "MetricName": "OutboxPermanentFailures",
        "Statistic": "Sum",
        "Period": 300,
        "EvaluationPeriods": 1,
        "Threshold": 1,
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "TreatMissingData": "notBreaching"
      }
    },
    "SyntheticConfigSecret": {
      "Type": "AWS::SecretsManager::Secret",
