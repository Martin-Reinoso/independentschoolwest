        "Namespace": "AWS/Lambda",
        "MetricName": "Throttles",
        "Dimensions": [
          {
            "Name": "FunctionName",
            "Value": {
              "Ref": "RosewoodFunction"
            }
          }
        ],
        "Statistic": "Sum",
        "Period": 300,
        "EvaluationPeriods": 1,
        "Threshold": 1,
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "TreatMissingData": "notBreaching"
      }
    },
    "RosewoodEmailDeliveryFailureAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
